# Opcional: caminho para o aios-core (se nao definido, usa a pasta squads/ local)
# AIOS_CORE_PATH=/Users/rafa/aios-core

# Webhook do Google Apps Script para persistir leads na planilha
# Sem essa var, o write no Sheets e pulado silenciosamente
GOOGLE_SHEETS_WEBHOOK=https://script.google.com/macros/s/AKfycb.../exec

# Webhook do GENE CRM para criar contatos no pipeline com a tag PROMPT
# Sem essa var, o write no GENE e pulado silenciosamente
GENE_WEBHOOK_URL=https://api.genecrm.com.br/webhook/leads/{UUID}

# ============================================================
# Agente de Trafego Pago (/traffic)
# ============================================================

# --- Meta / Facebook Marketing API (System User token, nao expira) ---
META_SYSTEM_USER_TOKEN=EAAB...
META_AD_ACCOUNT_ID=act_1234567890        # com o prefixo act_
META_PAGE_ID=1234567890                  # Pagina do FB que veicula o anuncio
META_IG_ACCOUNT_ID=1789...               # opcional: conta IG Business vinculada
META_API_VERSION=v23.0                   # opcional, default v23.0
# Use uma conta SANDBOX aqui durante os testes (nao gasta dinheiro real):
# META_AD_ACCOUNT_ID=act_<sandbox_id>

# --- OpenAI (gera a imagem do criativo via gpt-image-1) ---
# O cerebro do agente e o Claude Code (le a persona em squads/traffic-masters e
# usa o MCP server mcp/traffic-server.ts). Nao precisa de chave da Anthropic aqui.
OPENAI_API_KEY=sk-...
